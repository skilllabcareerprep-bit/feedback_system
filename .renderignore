# Virtual environments - DO NOT DEPLOY
venv/
.venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Testing and cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Node modules (shouldn't be here but exclude if present)
node_modules/

# Local development files
.env
.env.local
db.sqlite3
*.log

# Build outputs - DO NOT EXCLUDE staticfiles/ (needed by Render)
media/
*.egg-info

# Git files (not needed in deployment)
.git/
.gitignore
